# Auto detect text files and perform LF normalization
* text=auto

# Binary files
*.pdf binary
*.pkl binary
*.h5 binary
*.pth binary
*.keras binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Source code and text files
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ipynb text eol=lf
